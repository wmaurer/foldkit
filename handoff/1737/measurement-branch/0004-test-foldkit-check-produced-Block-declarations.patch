index 000000000..27a8dc1e0
--- /dev/null
+++ b/packages/foldkit/declaration-tests/produced-block-equality.ts
@@ -0,0 +1,21 @@
+export type Equal<Left, Right> =
+  (<Value>() => Value extends Left ? 1 : 2) extends <
+    Value,
+  >() => Value extends Right ? 1 : 2
+    ? (<Value>() => Value extends Right ? 1 : 2) extends <
+        Value,
+      >() => Value extends Left ? 1 : 2
+      ? true
+      : false
+    : false
+export type Assert<Value extends true> = Value
+export type MembersEqual<Left, Right> = Equal<
+  {
+    [Key in keyof Left]-?: Equal<
+      Left[Key],
+      Key extends keyof Right ? Right[Key] : never
+    >
+  }[keyof Left],
+  true
+>
+export type ReasonOf<Member> = Member[Exclude<keyof Member, 'evidence'>]
diff --git a/packages/foldkit/declaration-tests/produced-block-invalid.ts b/packages/foldkit/declaration-tests/produced-block-invalid.ts
new file mode 100644
index 000000000..3f70eb33c
--- /dev/null
