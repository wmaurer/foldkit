 packages/foldkit/src/block/definition.ts |  16 ++
 packages/foldkit/src/block/produced.ts   | 337 ++++++++++++++++++-----
 packages/foldkit/src/block/public.ts     |   1 -
 4 files changed, 336 insertions(+), 77 deletions(-)

