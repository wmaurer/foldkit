diff --git a/packages/foldkit/src/block/produced.ts b/packages/foldkit/src/block/produced.ts
new file mode 100644
index 000000000..d43544b5f
--- /dev/null
+++ b/packages/foldkit/src/block/produced.ts
@@ -0,0 +1,95 @@
+import type { Schema } from 'effect'
+
+import type { DefaultViewTypeId } from './defaultView.js'
+import type { LocalEffectsLayerTypeId, LocalMountsTypeId } from './definition.js'
+
+type InvalidBlockProducer = Readonly<{
+  'Block producer must return a completed Block': never
+}>
+
+type ProducedMember<Producer, Key extends PropertyKey> = [Producer] extends [never]
+  ? InvalidBlockProducer
+  : Producer extends (...args: ReadonlyArray<any>) => infer Completed
+    ? [Completed] extends [never]
+      ? InvalidBlockProducer
+      : Key extends keyof Completed
+        ? Completed[Key]
+        : InvalidBlockProducer
+    : InvalidBlockProducer
+
+interface ProducedBlockFields<
+  ModelSchema extends Schema.Codec<any, any, any, any>,
+  Producer,
+> {
+  readonly Model: ModelSchema
+  readonly owner: ProducedMember<Producer, 'owner'>
+  readonly Message: ProducedMember<Producer, 'Message'>
+  readonly mounts: ProducedMember<Producer, 'mounts'>
+  readonly [LocalMountsTypeId]: ProducedMember<Producer, typeof LocalMountsTypeId>
+  readonly bindings: ProducedMember<Producer, 'bindings'>
+  readonly init: ProducedMember<Producer, 'init'>
+  readonly update: ProducedMember<Producer, 'update'>
+  readonly operations: ProducedMember<Producer, 'operations'>
+  readonly subscriptions: ProducedMember<Producer, 'subscriptions'>
+  readonly managedResources: ProducedMember<Producer, 'managedResources'>
+  readonly EffectsLayer: ProducedMember<Producer, 'EffectsLayer'>
+  readonly [LocalEffectsLayerTypeId]: ProducedMember<
+    Producer,
+    typeof LocalEffectsLayerTypeId
+  >
+  readonly __blockHandlerRequirements: ProducedMember<
+    Producer,
+    '__blockHandlerRequirements'
+  >
+  readonly hostHandlers: ProducedMember<Producer, 'hostHandlers'>
+  readonly makeView: ProducedMember<Producer, 'makeView'>
+  readonly replaceEffectsLayer: ProducedMember<Producer, 'replaceEffectsLayer'>
+  readonly provideHandlers: ProducedMember<Producer, 'provideHandlers'>
+}
+
+/** Retains an independent Model Schema and a producer's exact completed capabilities. */
+export interface ProducedBlockWithViewAndOutMessage<
+  ModelSchema extends Schema.Codec<any, any, any, any>,
+  Producer,
+> extends ProducedBlockFields<ModelSchema, Producer> {
+  readonly OutMessage: ProducedMember<Producer, 'OutMessage'>
+  readonly [DefaultViewTypeId]: ProducedMember<Producer, typeof DefaultViewTypeId>
+}
+
+/** Retains an independent Model Schema and a producer's exact completed view capabilities. */
+export interface ProducedBlockWithView<
+  ModelSchema extends Schema.Codec<any, any, any, any>,
+  Producer,
+> extends ProducedBlockFields<ModelSchema, Producer> {
+  readonly OutMessage?: never
+  readonly [DefaultViewTypeId]: ProducedMember<Producer, typeof DefaultViewTypeId>
+}
+
+/** Retains an independent Model Schema and a producer's exact completed OutMessage capabilities. */
+export interface ProducedBlockWithOutMessage<
+  ModelSchema extends Schema.Codec<any, any, any, any>,
+  Producer,
+> extends ProducedBlockFields<ModelSchema, Producer> {
+  readonly OutMessage: ProducedMember<Producer, 'OutMessage'>
+  readonly [DefaultViewTypeId]?: never
+}
+
+/** Retains an independent Model Schema and a producer's exact completed capabilities without a view or OutMessage. */
+export interface ProducedBlockWithoutViewOrOutMessage<
+  ModelSchema extends Schema.Codec<any, any, any, any>,
+  Producer,
+> extends ProducedBlockFields<ModelSchema, Producer> {
+  readonly OutMessage?: never
+  readonly [DefaultViewTypeId]?: never
+}
+
+/** The completed Block a Composition's `produceBlock` returns. Its `Model` comes
+ * from the Composition, so reading it does not type the producer. Every other
+ * member is read from the producer's completed Block on demand. */
+export type ProducedCompositionBlock<
+  ModelSchema extends Schema.Codec<any, any, any, any>,
+  OutMessageSchema,
+  Producer,
+> = OutMessageSchema extends Schema.Codec<any, any, any, any>
+  ? ProducedBlockWithViewAndOutMessage<ModelSchema, Producer>
+  : ProducedBlockWithView<ModelSchema, Producer>
